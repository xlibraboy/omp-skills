providers:
  databyte:
    baseUrl: https://ai.databyte.co.id/v1
    api: openai-completions
    apiKey: YOUR_DATABYTE_KEY
    authHeader: true
    models:
      - id: databyte-m1
        name: Databyte M1
        contextWindow: 200000
        maxTokens: 100000
      - id: deepseek-v4-flash
        name: DeepSeek V4 Flash
        contextWindow: 1000000
        maxTokens: 100000
      - id: MiniMax-M3
        name: MiniMax M3
        contextWindow: 200000
        maxTokens: 100000

  sumopod:
    baseUrl: https://ai.sumopod.com/v1
    api: openai-completions
    apiKey: YOUR_SUMOPOD_KEY
    authHeader: true
    models:
      - id: deepseek-v4-flash
        name: DeepSeek V4 Flash
        contextWindow: 1000000
        maxTokens: 100000
      - id: deepseek-v4-pro
        name: DeepSeek V4 Pro
        contextWindow: 1000000
        maxTokens: 100000

  openagentic:
    baseUrl: https://openagentic.id/api/v1
    api: openai-completions
    apiKey: YOUR_OPENAGENTIC_KEY
    authHeader: true
    models:
      - id: grok-4.5
        name: Grok 4.5
        contextWindow: 1000000
        maxTokens: 100000
